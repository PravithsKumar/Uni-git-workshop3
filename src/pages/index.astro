---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const database = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(database),
  getAllCategories(database),
  getAllPublishers(database),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="mb-6 flex flex-col gap-4 rounded-xl border border-slate-700 bg-slate-800/50 p-4 sm:flex-row sm:items-end" data-testid="game-filters">
            <div class="flex-1">
              <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Filter by category</label>
              <select
                id="category-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-testid="category-filter"
              >
                <option value="">All categories</option>
                {categories.map((category) => <option value={category.id}>{category.name}</option>)}
              </select>
            </div>

            <div class="flex-1">
              <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Filter by publisher</label>
              <select
                id="publisher-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
              </select>
            </div>

            <button
              type="button"
              class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="clear-filters"
            >
              Clear filters
            </button>
          </div>

          <p class="mb-4 text-sm text-slate-400" data-testid="filter-result-count" role="status" aria-live="polite">
            Showing {games.length} games
          </p>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div id="filter-empty-state" hidden data-testid="filter-empty-state">
            <EmptyState text="No games match those filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryFilter = document.querySelector<HTMLSelectElement>('#category-filter');
  const publisherFilter = document.querySelector<HTMLSelectElement>('#publisher-filter');
  const clearFilters = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const emptyState = document.querySelector<HTMLElement>('#filter-empty-state');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

  if (categoryFilter && publisherFilter && clearFilters && resultCount && emptyState) {
    const categorySelect = categoryFilter;
    const publisherSelect = publisherFilter;
    const resetButton = clearFilters;
    const status = resultCount;
    const noResults = emptyState;
    const params = new URLSearchParams(window.location.search);
    const initialCategory = params.get('category') ?? '';
    const initialPublisher = params.get('publisher') ?? '';

    if (Array.from(categorySelect.options).some((option) => option.value === initialCategory)) {
      categorySelect.value = initialCategory;
    }
    if (Array.from(publisherSelect.options).some((option) => option.value === initialPublisher)) {
      publisherSelect.value = initialPublisher;
    }

    function updateUrl(): void {
      const url = new URL(window.location.href);

      if (categorySelect.value) {
        url.searchParams.set('category', categorySelect.value);
      } else {
        url.searchParams.delete('category');
      }

      if (publisherSelect.value) {
        url.searchParams.set('publisher', publisherSelect.value);
      } else {
        url.searchParams.delete('publisher');
      }

      window.history.replaceState(null, '', url);
    }

    function applyFilters(): void {
      const categoryId = categorySelect.value;
      const publisherId = publisherSelect.value;
      let visibleCount = 0;

      for (const card of cards) {
        const matchesCategory = !categoryId || card.dataset.gameCategoryId === categoryId;
        const matchesPublisher = !publisherId || card.dataset.gamePublisherId === publisherId;
        const isVisible = matchesCategory && matchesPublisher;

        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      }

      status.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
      noResults.hidden = visibleCount > 0;
      updateUrl();
    }

    categorySelect.addEventListener('change', applyFilters);
    publisherSelect.addEventListener('change', applyFilters);
    resetButton.addEventListener('click', () => {
      categorySelect.value = '';
      publisherSelect.value = '';
      applyFilters();
    });

    applyFilters();
  }
</script>
